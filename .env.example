# ============================================================
# AI-Platform 환경변수 템플릿
# 사용법: 각 프로젝트 폴더에 .env.example → .env 복사 후 값 입력
# ============================================================

# ============ react-agent ============
# OPENAI_API_KEY=sk-...
# TAVILY_API_KEY=tvly-...
# UPSTAGE_API_KEY=up-...
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ReAct-Agent-Template
# LANGGRAPH_API_URL=http://localhost:2024
# LANGGRAPH_AUTH_KEY=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=app_db
# DB_USER=app_user
# DB_PASSWORD=

# ============ document-parser-server ============
# UPSTAGE_API_KEY=up-...          (react-agent와 동일)
# OPENAI_API_KEY=sk-...           (react-agent와 동일)
# PORT=9997

# ============ file-manager-admin ============
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=app_db
# DB_USER=app_user
# DB_PASSWORD=
# PARSER_SERVER_URL=http://localhost:9997

# ============ agent-chat-ui ============
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_ASSISTANT_ID=agent
# LANGSMITH_API_KEY=lsv2_...      (react-agent와 동일)
# LANGGRAPH_AUTH_KEY=              (react-agent와 동일)
